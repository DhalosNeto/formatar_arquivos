# API
PORTA=8080
AMBIENTE=desenvolvimento
NIVEL_LOG=info

# Banco
POSTGRES_DSN=postgres://formatador:formatador@localhost:5432/formatador?sslmode=disable

# Storage (MinIO)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=documentos
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_REGIAO=us-east-1

# Conversor DOCX -> PDF
CONVERSOR_URL=http://localhost:2004

# Telemetria
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# LLM (fallback de classificação)
ANTHROPIC_API_KEY=
LLM_MODELO=claude-opus-5
LLM_HABILITADO=false

# Jev: fallback semântico experimental (worker). Ativar envia trechos à TypeSafe.
# LLM_* acima são configurações legadas; Jev usa somente as variáveis abaixo.
JEV_HABILITADO=false
TYPESAFE_API_KEY=
JEV_MODELO=jev-latest
# Limites iniciais, ainda sem calibração em artigos reais.
JEV_LIMITE_CONSULTA=0.7
JEV_LIMITE_CONFIRMACAO=0.7
JEV_LIMITE_AUTOMATICO=0.95
